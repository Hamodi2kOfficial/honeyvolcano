# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The static export IS tracked, on purpose. It is the folder the owner
# uploads to publish, and he keeps it in the repository so there is always a
# copy of exactly what is on the site. Rebuild it with `npm run build` and
# commit it with whatever change produced it.
#
# It does not contain netlify/functions — those live outside it — so a deploy
# made from this folder alone leaves the site without its /api/* routes.

# Personal paperwork and local-only scripts. Kept out of a public repository;
# the patterns stay even though these live outside it, in case one is ever
# copied in by hand.
*.pdf
*.docx
*nvoice*
scripts/make-*-pdf.js

# Stray root asset, not part of the site
WhatsApp Image*.jpeg

# Local Netlify folder
.netlify

# Written by the Netlify CLI when it deploys the edge functions — hashes of
# its own bootstrap files, nothing of ours.
deno.lock

# Playwright
/test-results/
/playwright-report/
